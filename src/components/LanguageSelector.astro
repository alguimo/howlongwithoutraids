---
import { FLAG_LANG, flagSvg } from "../lib/flags";
import { t } from "../lib/i18n";
import type { Language } from "../lib/types";

interface Props {
  lang?: Language;
}

const { lang = "en" } = Astro.props;

const NAME_KEY: Record<Language, string> = {
  es: "lang_name_es",
  en: "lang_name_en",
  fr: "lang_name_fr",
};
---

<div class="relative" data-language-selector>
  <button
    id="language"
    type="button"
    class="lang-trigger-btn flex h-8 items-center gap-1.5 rounded-md px-2 text-sm outline-none transition-colors"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-controls="language-menu"
  >
    <span class="sr-only" data-i18n="change_language">{t(lang, "change_language")}</span>
    <span data-language-flag set:html={flagSvg(lang)}></span>
    <svg
      viewBox="0 0 16 16"
      width="12"
      height="12"
      aria-hidden="true"
      focusable="false"
      class="opacity-70"
    >
      <path
        d="M4 6l4 4 4-4"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </button>
  <ul
    id="language-menu"
    role="listbox"
    aria-labelledby="language"
    hidden
    class="lang-menu-popup absolute right-0 z-30 mt-2 min-w-36 rounded-md p-1"
  >
    {
      FLAG_LANG.map((code) => (
        <li
          role="option"
          data-lang={code}
          tabindex="-1"
          aria-selected={code === lang ? "true" : "false"}
          class="lang-menu-option flex cursor-pointer items-center gap-2 rounded px-2 py-1.5 text-sm outline-none"
        >
          <span data-option-flag set:html={flagSvg(code)}></span>
          <span data-i18n={NAME_KEY[code]}>{t(lang, NAME_KEY[code])}</span>
        </li>
      ))
    }
  </ul>
</div>
