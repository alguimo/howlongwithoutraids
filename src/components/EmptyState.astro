---
import { t } from "../lib/i18n";
---

<div
  id="empty"
  hidden
  class="empty-state mt-4 flex flex-col items-center justify-center gap-2.5 rounded-lg px-6 py-8 text-center"
>
  <p class="empty-title text-sm font-medium" data-i18n="no_results">{t("en", "no_results")}</p>
  <p class="empty-hint text-xs" data-i18n="no_results_hint">{t("en", "no_results_hint")}</p>
  <button
    id="clear"
    type="button"
    class="empty-clear-btn mt-1 inline-flex items-center rounded-md px-3 py-1.5 text-xs font-medium outline-none transition-colors"
  >
    <span data-i18n="clear">{t("en", "clear")}</span>
  </button>
</div>
