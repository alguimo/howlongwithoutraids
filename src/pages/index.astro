---
import EmptyState from "../components/EmptyState.astro";
import FilterBar from "../components/FilterBar.astro";
import Footer from "../components/Footer.astro";
import LanguageSelector from "../components/LanguageSelector.astro";
import SearchBox from "../components/SearchBox.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import "../styles/global.css";
import data from "../data/raids-snapshot.json";
import metaData from "../data/snapshot-meta.json";
import { isActive } from "../lib/counter";
import { listHtml, paginationHtml, tableHeadHtml } from "../lib/html";
import { t } from "../lib/i18n";
import { sortBosses } from "../lib/order";
import { pageSlice, pageState } from "../lib/pagination";
import { parseSnapshot, parseSnapshotMeta } from "../lib/snapshot";

const bosses = parseSnapshot(data);
const meta = parseSnapshotMeta(metaData);
const now = new Date();
const activeBossesCount = bosses.filter((b) => isActive(b, now)).length;

// El build pinta la primera página compacta (12 filas); en escritorio el cliente
// ajusta dinámicamente el tamaño de página al alto libre del viewport (Spec 010 RF-09).
const initialState = pageState(bosses.length, 1);
const rows = listHtml(pageSlice(sortBosses(bosses, now, "en"), 1), now, "en");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>How Long Without Raids</title>
    <meta name="description" content="Check how long each Pokémon has gone without appearing in Pokémon GO raids. Fast, clean, and up to date." />
    <meta name="theme-color" content="#121110" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content="How Long Without Raids" />
    <meta property="og:description" content="Check how long each Pokémon has gone without appearing in Pokémon GO raids." />
    <meta property="og:type" content="website" />
    <script is:inline>
      (function() {
        var theme = "dark";
        try {
          var lang = localStorage.getItem("hlwr:lang");
          if (lang === "es" || lang === "en" || lang === "fr") {
            document.documentElement.lang = lang;
          }
          var storedTheme = localStorage.getItem("hlwr_theme");
          if (storedTheme === "light" || storedTheme === "dark") {
            theme = storedTheme;
          } else if (window.matchMedia && !window.matchMedia("(prefers-color-scheme: dark)").matches) {
            theme = "light";
          }
        } catch (e) {}
        document.documentElement.dataset.theme = theme;
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute("content", theme === "light" ? "#f6f5f1" : "#121110");
      })();
    </script>
  </head>
  <body>
    <!-- RF-29, RF-42: la cabecera es una sola instancia y vive como hermana
         anterior de <main>, fuera del contenedor con desplazamiento de la
         tabla. Cualquier ancestro con `overflow` distinto de `visible`,
         `transform`, `filter` o `contain` anularía el pegado en silencio. -->
    <header class="app-header">
      <div class="mx-auto max-w-5xl px-4 py-3 sm:px-6 sm:py-3.5">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight" data-i18n="title">How Long Without Raids</h1>
            <div class="mt-0.5 flex flex-wrap items-center gap-x-2.5 gap-y-0.5 text-xs sm:text-sm">
              <p class="header-subtitle" data-i18n="subtitle">{t("en", "subtitle")}</p>
              <span class="header-subtitle hidden sm:inline" aria-hidden="true">·</span>
              <span class="header-raid-stat font-medium tabular-nums">
                <span data-active-raids-count>{t("en", "active_raids_count", { count: activeBossesCount })}</span>
              </span>
            </div>
          </div>
          <div class="flex items-center gap-1.5 shrink-0 pt-0.5">
            <ThemeToggle />
            <LanguageSelector />
          </div>
        </div>
        <SearchBox />
      </div>
    </header>
    <main class="mx-auto max-w-5xl px-4 py-3 sm:px-6 sm:py-4">
      <FilterBar />
      <EmptyState />
      <div id="table-wrap" class="mt-1 overflow-x-auto">
        <table class="w-full border-collapse">
          <thead id="boss-head" set:html={tableHeadHtml("en")}></thead>
          <tbody id="boss-list" set:html={rows}></tbody>
        </table>
      </div>
      <div class="pb-3" set:html={paginationHtml(initialState, "en")}></div>
      <Footer exportedAt={meta.exported_at} />
    </main>
    <script>
      import { start } from "../client/app";
      start();
    </script>
  </body>
</html>
