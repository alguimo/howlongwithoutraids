---
import { footerUpdatedText } from "../lib/html";

interface Props {
  exportedAt: string | null;
}

const { exportedAt } = Astro.props;
const updated = footerUpdatedText(exportedAt, "en");
---

<footer class="app-footer mt-auto pt-3 text-xs sm:text-sm">
  <span data-i18n="footer_data">Data from</span>
  <a class="underline underline-offset-4" href="https://leekduck.com" rel="noopener">LeekDuck</a>
  <span aria-hidden="true">·</span>
  <a
    class="underline underline-offset-4"
    href="https://github.com/bigfoott/ScrapedDuck"
    rel="noopener">ScrapedDuck</a>
  <span data-footer-updated-wrap hidden={updated === null}>
    <span aria-hidden="true">·</span>
    <span data-footer-updated>{updated ?? ""}</span>
  </span>
</footer>
